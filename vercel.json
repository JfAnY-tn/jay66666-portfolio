{
  "functions": {
    "api/bilibili-proxy.js": { "regions": ["hkg1"] },
    "api/video-proxy.js": { "regions": ["hkg1"] }
  },
  "routes": [
    { "src": "/api/bilibili/(.*)", "dest": "/api/bilibili-proxy?path=$1" }
  ],
  "rewrites": [
    { "source": "/api/youtube/:path*", "destination": "https://www.youtube.com/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
